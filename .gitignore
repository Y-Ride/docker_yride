# Ignore ROS2 build and install directories
**/log/
**/build/
**/install/

# Ignore settings that can be modified by the user
.vscode/

# Bag files are too large for github.
# If they need to be shared, upload to box and share the link.
ros2_ws/bags/*/
data_byu
*.json
*.log

# Ignore sensor logs
**/log_ouster/

**/trash/

# Ignore .txt files in timestamps_to_txt
ros2_ws/src/timestamps_to_txt/t*.txt

# Ignore maps for now
**/maps/**/

# Ignore python cache
**__pycache__/
*.pyc

# Ignore docker compose computer specific files
*.extra.yaml